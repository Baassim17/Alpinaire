    "ssrStaticProps":  "{\"props\": {\"data\": {\"id\": 2,\"attributes\": {\"surtitle\": \"Alpinaire, the custom watchmaking studio\",\"title\": \"The Ultimate Luxury: Making Time Your Own\",\"createdAt\": \"2024-10-29T11:46:18.595Z\",\"updatedAt\": \"2025-08-02T19:03:54.449Z\",\"baseline\": \"\",\"richIntroduction\": [{\"type\": \"paragraph\",\"children\": [{\"type\": \"text\",\"text\": \"Imagine a luxury that goes beyond owning a watch and becomes a way to express your identity. Our service offers high-end customization of existing timepieces, transforming them into unique creations. We work exclusively on watches that are owned and entrusted to us by our clients. This bespoke process is available by request for private use only.\"}]}],\"keywords\": [{\"id\": 4,\"text\": \"Swiss quality\",\"image\": {\"data\": {\"id\": 70,\"attributes\": {\"name\": \"HOMEPAGE_SWISS QUALITY.mp4\",\"alternativeText\": null,\"caption\": null,\"width\": null,\"height\": null,\"formats\": {},\"hash\": \"HOMEPAGE_SWISS_QUALITY_c4bc2d470f\",\"ext\": \".mp4\",\"mime\": \"video/mp4\",\"size\": 2985.72,\"url\": \"/uploads/HOMEPAGE_SWISS_QUALITY_c4bc2d470f.mp4\",\"previewUrl\": null,\"provider\": \"local\",\"provider_metadata\": null,\"createdAt\": \"2024-11-22T08:12:29.791Z\",\"updatedAt\": \"2024-12-04T12:21:55.343Z\"}}}},{\"id\": 5,\"text\": \"Innovation\",\"image\": {\"data\": {\"id\": 69,\"attributes\": {\"name\": \"HOMEPAGE_INNOVATION.mp4\",\"alternativeText\": null,\"caption\": null,\"width\": null,\"height\": null,\"formats\": {},\"hash\": \"HOMEPAGE_INNOVATION_3c5f31c5f9\",\"ext\": \".mp4\",\"mime\": \"video/mp4\",\"size\": 2529.24,\"url\": \"/uploads/HOMEPAGE_INNOVATION_3c5f31c5f9.mp4\",\"previewUrl\": null,\"provider\": \"local\",\"provider_metadata\": null,\"createdAt\": \"2024-11-22T08:11:50.011Z\",\"updatedAt\": \"2024-12-04T12:22:12.459Z\"}}}},{\"id\": 6,\"text\": \"Tradition\",\"image\": {\"data\": {\"id\": 88,\"attributes\": {\"name\": \"HOMEPAGE_TRADITION.mp4\",\"alternativ