{"data":[{"id":31,"attributes":{"title":"NO.306","subtitle":" ","createdAt":"2026-02-27T11:17:40.862Z","updatedAt":"2026-05-12T08:44:45.946Z","publishedAt":"2026-02-27T13:21:09.002Z","rank":-4,"slug":"NO.306","richIntroduction":[{"type":"paragraph","children":[{"type":"text","text":"Originally conceived as a distinctive luxury sports watch, this timepiece was defined by its massive bezel and articulated rubber strap lugs. It offered a strong architectural foundation. Alpinaire revisits it with an illustrated dial and a deep black case, reinforcing its presence with a graphic identity while preserving its original structure."}]}],"mainMedia":{"data":{"id":706,"attributes":{"name":"1. Bulgari lune_close up_16-9_pixels.jpg","alternativeText":null,"caption":null,"width":8217,"height":4622,"formats":{"thumbnail":{"name":"thumbnail_1. Bulgari lune_close up_16-9_pixels.jpg","hash":"thumbnail_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":576,"size":43.9,"sizeInBytes":43898,"url":"/uploads/thumbnail_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c.jpg"},"small":{"name":"small_1. Bulgari lune_close up_16-9_pixels.jpg","hash":"small_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":576,"size":43.9,"sizeInBytes":43898,"url":"/uploads/small_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c.jpg"},"xsmall":{"name":"xsmall_1. Bulgari lune_close up_16-9_pixels.jpg","hash":"xsmall_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":576,"size":43.9,"sizeInBytes":43898,"url":"/uploads/xsmall_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c.jpg"},"large":{"name":"large_1. Bulgari lune_close up_16-9_pixels.jpg","hash":"large_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c","ext":".jpg","mime":"image/jpeg","path":null,"width":1920,"height":1080,"size":122.54,"sizeInBytes":122543,"url":"/uploads/large_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c.jpg"},"medium":{"name":"medium_1. Bulgari lune_close up_16-9_pixels.jpg","hash":"medium_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c","ext":".jpg","mime":"image/jpeg","path":null,"width":1440,"height":810,"size":76.03,"sizeInBytes":76033,"url":"/uploads/medium_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c.jpg"},"xlarge":{"name":"xlarge_1. Bulgari lune_close up_16-9_pixels.jpg","hash":"xlarge_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c","ext":".jpg","mime":"image/jpeg","path":null,"width":2440,"height":1373,"size":182.81,"sizeInBytes":182814,"url":"/uploads/xlarge_1_Bulgari_lune_close_up_16_9_pixels_2cc117388c.jpg"}},"hash":"1_Bulgari_lune_close_up_16_9_pixels_2cc117388c","ext":".jpg","mime":"image/jpeg","size":4860.77,"url":"/uploads/1_Bulgari_lune_close_up_16_9_pixels_2cc117388c.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-02-27T11:18:17.271Z","updatedAt":"2026-02-27T11:18:17.271Z"}}},"content":[{"id":82,"__component":"content.text-media","title":"The Owner’s Vision","richText":[{"type":"paragraph","children":[{"type":"text","text":"The owner wanted to reinterpret his watch with a design reflecting something personal. Based on his description of a place that holds particular meaning for him, our designers helped him design the pattern of the moon and leaf for the dial. As a frequent traveler, he saw the GMT complication as the ideal foundation for a project expressing both movement and attachment. The watch became a way for him to carry that place with him wherever he goes."}]}],"disableParallax":false,"media":{"data":{"id":727,"attributes":{"name":"Bulgari lune_vue basse_1-1_pixels.jpg","alternativeText":null,"caption":null,"width":4000,"height":4000,"formats":{"thumbnail":{"name":"thumbnail_Bulgari lune_vue basse_1-1_pixels.jpg","hash":"thumbnail_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":67.04,"sizeInBytes":67035,"url":"/uploads/thumbnail_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464.jpg"},"small":{"name":"small_Bulgari lune_vue basse_1-1_pixels.jpg","hash":"small_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":67.04,"sizeInBytes":67035,"url":"/uploads/small_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464.jpg"},"xsmall":{"name":"xsmall_Bulgari lune_vue basse_1-1_pixels.jpg","hash":"xsmall_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":67.04,"sizeInBytes":67035,"url":"/uploads/xsmall_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464.jpg"},"medium":{"name":"medium_Bulgari lune_vue basse_1-1_pixels.jpg","hash":"medium_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464","ext":".jpg","mime":"image/jpeg","path":null,"width":1440,"height":1440,"size":118.95,"sizeInBytes":118945,"url":"/uploads/medium_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464.jpg"},"large":{"name":"large_Bulgari lune_vue basse_1-1_pixels.jpg","hash":"large_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464","ext":".jpg","mime":"image/jpeg","path":null,"width":1920,"height":1920,"size":194.2,"sizeInBytes":194199,"url":"/uploads/large_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464.jpg"},"xlarge":{"name":"xlarge_Bulgari lune_vue basse_1-1_pixels.jpg","hash":"xlarge_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464","ext":".jpg","mime":"image/jpeg","path":null,"width":2440,"height":2440,"size":295.08,"sizeInBytes":295076,"url":"/uploads/xlarge_Bulgari_lune_vue_basse_1_1_pixels_24f06c9464.jpg"}},"hash":"Bulgari_lune_vue_basse_1_1_pixels_24f06c9464","ext":".jpg","mime":"image/jpeg","size":2926.01,"url":"/uploads/Bulgari_lune_vue_basse_1_1_pixels_24f06c9464.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-02-27T13:37:07.715Z","updatedAt":"2026-02-27T13:37:07.715Z"}}}},{"id":83,"__component":"content.text-media","title":"Preparation and Restoration","richText":[{"type":"paragraph","children":[{"type":"text","text":"The transformation begins with a full disassembly of the watch. Each component is inspected, serviced, and restored. The surfaces are then refined to preserve the original brushed finishes before the customization process continues."}]}],"disableParallax":true,"media":{"data":{"id":708,"attributes":{"name":"3. BULGARI LUNE_lunette + aiguilles 1-1.jpg","alternativeText":null,"caption":null,"width":4143,"height":4143,"formats":{"thumbnail":{"name":"thumbnail_3. BULGARI LUNE_lunette + aiguilles 1-1.jpg","hash":"thumbnail_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":38.62,"sizeInBytes":38623,"url":"/uploads/thumbnail_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0.jpg"},"small":{"name":"small_3. BULGARI LUNE_lunette + aiguilles 1-1.jpg","hash":"small_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":38.62,"sizeInBytes":38623,"url":"/uploads/small_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0.jpg"},"xsmall":{"name":"xsmall_3. BULGARI LUNE_lunette + aiguilles 1-1.jpg","hash":"xsmall_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":38.62,"sizeInBytes":38623,"url":"/uploads/xsmall_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0.jpg"},"large":{"name":"large_3. BULGARI LUNE_lunette + aiguilles 1-1.jpg","hash":"large_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0","ext":".jpg","mime":"image/jpeg","path":null,"width":1920,"height":1920,"size":103.95,"sizeInBytes":103948,"url":"/uploads/large_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0.jpg"},"medium":{"name":"medium_3. BULGARI LUNE_lunette + aiguilles 1-1.jpg","hash":"medium_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0","ext":".jpg","mime":"image/jpeg","path":null,"width":1440,"height":1440,"size":65.76,"sizeInBytes":65762,"url":"/uploads/medium_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0.jpg"},"xlarge":{"name":"xlarge_3. BULGARI LUNE_lunette + aiguilles 1-1.jpg","hash":"xlarge_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0","ext":".jpg","mime":"image/jpeg","path":null,"width":2440,"height":2440,"size":152.05,"sizeInBytes":152050,"url":"/uploads/xlarge_3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0.jpg"}},"hash":"3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0","ext":".jpg","mime":"image/jpeg","size":960.88,"url":"/uploads/3_BULGARI_LUNE_lunette_aiguilles_1_1_f8cb5bd1a0.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-02-27T11:22:15.810Z","updatedAt":"2026-02-27T11:22:15.810Z"}}}},{"id":84,"__component":"content.text-media","title":"Dial Composition","richText":[{"type":"paragraph","children":[{"type":"text","text":"The dial design was developed through a series of sketches by our design team. Several compositional options were explored, refining the balance between the moon and the leaf pattern before defining the final motif. The illustration was then simplified and adapted to preserve legibility. The textured matte black base establishes depth, while the yellow moon draws the eye against the dark background."}]}],"disableParallax":true,"media":{"data":{"id":724,"attributes":{"name":"Bulgari diagono gmt_planche dessin + cadran.jpg","alternativeText":null,"caption":null,"width":2048,"height":2048,"formats":{"thumbnail":{"name":"thumbnail_Bulgari diagono gmt_planche dessin + cadran.jpg","hash":"thumbnail_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":183.71,"sizeInBytes":183705,"url":"/uploads/thumbnail_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a.jpg"},"small":{"name":"small_Bulgari diagono gmt_planche dessin + cadran.jpg","hash":"small_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":183.71,"sizeInBytes":183705,"url":"/uploads/small_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a.jpg"},"xsmall":{"name":"xsmall_Bulgari diagono gmt_planche dessin + cadran.jpg","hash":"xsmall_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":183.71,"sizeInBytes":183705,"url":"/uploads/xsmall_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a.jpg"},"medium":{"name":"medium_Bulgari diagono gmt_planche dessin + cadran.jpg","hash":"medium_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a","ext":".jpg","mime":"image/jpeg","path":null,"width":1440,"height":1440,"size":305.69,"sizeInBytes":305687,"url":"/uploads/medium_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a.jpg"},"large":{"name":"large_Bulgari diagono gmt_planche dessin + cadran.jpg","hash":"large_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a","ext":".jpg","mime":"image/jpeg","path":null,"width":1920,"height":1920,"size":457.76,"sizeInBytes":457762,"url":"/uploads/large_Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a.jpg"}},"hash":"Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a","ext":".jpg","mime":"image/jpeg","size":1595.13,"url":"/uploads/Bulgari_diagono_gmt_planche_dessin_cadran_913dc8897a.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-02-27T13:25:06.750Z","updatedAt":"2026-02-27T13:25:06.750Z"}}}},{"id":58,"__component":"content.media-duo","format":"portrait","disableParallax":true,"showWithoutMargin":false,"mobileInline":true,"media1":{"data":{"id":710,"attributes":{"name":"5. Bulgari diagono gmt_dessin montre.jpg","alternativeText":null,"caption":null,"width":941,"height":1175,"formats":{"thumbnail":{"name":"thumbnail_5. Bulgari diagono gmt_dessin montre.jpg","hash":"thumbnail_5_Bulgari_diagono_gmt_dessin_montre_8108587b07","ext":".jpg","mime":"image/jpeg","path":null,"width":820,"height":1024,"size":91.33,"sizeInBytes":91325,"url":"/uploads/thumbnail_5_Bulgari_diagono_gmt_dessin_montre_8108587b07.jpg"},"small":{"name":"small_5. Bulgari diagono gmt_dessin montre.jpg","hash":"small_5_Bulgari_diagono_gmt_dessin_montre_8108587b07","ext":".jpg","mime":"image/jpeg","path":null,"width":820,"height":1024,"size":91.33,"sizeInBytes":91325,"url":"/uploads/small_5_Bulgari_diagono_gmt_dessin_montre_8108587b07.jpg"},"xsmall":{"name":"xsmall_5. Bulgari diagono gmt_dessin montre.jpg","hash":"xsmall_5_Bulgari_diagono_gmt_dessin_montre_8108587b07","ext":".jpg","mime":"image/jpeg","path":null,"width":820,"height":1024,"size":91.33,"sizeInBytes":91325,"url":"/uploads/xsmall_5_Bulgari_diagono_gmt_dessin_montre_8108587b07.jpg"}},"hash":"5_Bulgari_diagono_gmt_dessin_montre_8108587b07","ext":".jpg","mime":"image/jpeg","size":306.83,"url":"/uploads/5_Bulgari_diagono_gmt_dessin_montre_8108587b07.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-02-27T11:24:11.135Z","updatedAt":"2026-02-27T11:24:11.135Z"}}},"media2":{"data":{"id":711,"attributes":{"name":"6. Bulgari diagono gmt_dessin cadran.jpg","alternativeText":null,"caption":null,"width":941,"height":1175,"formats":{"thumbnail":{"name":"thumbnail_6. Bulgari diagono gmt_dessin cadran.jpg","hash":"thumbnail_6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e","ext":".jpg","mime":"image/jpeg","path":null,"width":820,"height":1024,"size":103.56,"sizeInBytes":103561,"url":"/uploads/thumbnail_6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e.jpg"},"small":{"name":"small_6. Bulgari diagono gmt_dessin cadran.jpg","hash":"small_6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e","ext":".jpg","mime":"image/jpeg","path":null,"width":820,"height":1024,"size":103.56,"sizeInBytes":103561,"url":"/uploads/small_6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e.jpg"},"xsmall":{"name":"xsmall_6. Bulgari diagono gmt_dessin cadran.jpg","hash":"xsmall_6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e","ext":".jpg","mime":"image/jpeg","path":null,"width":820,"height":1024,"size":103.56,"sizeInBytes":103561,"url":"/uploads/xsmall_6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e.jpg"}},"hash":"6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e","ext":".jpg","mime":"image/jpeg","size":305.85,"url":"/uploads/6_Bulgari_diagono_gmt_dessin_cadran_e2fc65e62e.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-02-27T11:24:19.462Z","updatedAt":"2026-02-27T11:24:19.462Z"}}}},{"id":47,"__component":"content.text-column","richText":[{"type":"paragraph","children":[{"type":"text","text":"This customization balances graphic expression with technical structure. It integrates narrative elements while preserving the functional clarity expected of a GMT sports watch."}]}]},{"id":85,"__component":"content.text-media","title":"Dial Painting","richText":[{"type":"paragraph","children":[{"type":"text","text":"The work of the dial maker is at the heart of this project. The base was first machined to create its fine grained texture before the black background was applied in layered spray coats. The motif and indexes were constructed through sequential decal applications, beginning with the yellow moon, followed by the gray green leaves, and finally the white indexes and logo, each carefully aligned. The hands were then individually painted using pigments mixed in house."}]}],"disableParallax":true,"media":{"data":{"id":712,"attributes":{"name":"7. PEINTURE.mp4","alternativeText":null,"caption":null,"width":null,"height":null,"formats":null,"hash":"7_PEINTURE_5b5ac85b5e","ext":".mp4","mime":"video/mp4","size":11213.18,"url":"/uploads/7_PEINTURE_5b5ac85b5e.mp4","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-02-27T11:25:56.322Z","updatedAt":"2026-02-27T11:25:56.322Z"}}}},{"id":86,"__component":"content.text-media","title":"Black DLC Coating","richText":[{"type":"paragraph","children":[{"type":"text","text":"All yellow gold components were treated with a black diamond like carbon coating, including the case, bezel, crown, pushers and articulated lugs. This amorphous carbon based layer is applied as a micrometric coating, offering high resistance to wear. The white numerals on the 24 hour bezel were painted by hand to reinforce legibility against the dark surface. The black rubber strap remains unchanged, maintaining the architectural character of the watch."}]}],"disableParallax":true,"media":{"data":{"id":733,"attributes":{"name":"Bulgari lune_boite_1-1_pixels.jpg","alternativeText":null,"caption":null,"width":3994,"height":3994,"formats":{"thumbnail":{"name":"thumbnail_Bulgari lune_boite_1-1_pixels.jpg","hash":"thumbnail_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":73.79,"sizeInBytes":73791,"url":"/uploads/thumbnail_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae.jpg"},"medium":{"name":"medium_Bulgari lune_boite_1-1_pixels.jpg","hash":"medium_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae","ext":".jpg","mime":"image/jpeg","path":null,"width":1440,"height":1440,"size":130.75,"sizeInBytes":130749,"url":"/uploads/medium_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae.jpg"},"small":{"name":"small_Bulgari lune_boite_1-1_pixels.jpg","hash":"small_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":73.79,"sizeInBytes":73791,"url":"/uploads/small_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae.jpg"},"xsmall":{"name":"xsmall_Bulgari lune_boite_1-1_pixels.jpg","hash":"xsmall_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae","ext":".jpg","mime":"image/jpeg","path":null,"width":1024,"height":1024,"size":73.79,"sizeInBytes":73791,"url":"/uploads/xsmall_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae.jpg"},"large":{"name":"large_Bulgari lune_boite_1-1_pixels.jpg","hash":"large_Bulgari_lune_boite_1_1_pixels_5c5abdb1ae","ext":".jpg","mime":"image/jpeg","path":null,"width":1920,"height":1920,"size":212.4,"sizeInBytes":212396,"url":"/uploads/large_Bulgari_lune_boi