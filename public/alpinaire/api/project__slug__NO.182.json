 smoked sapphire dial introduces transparency while preserving legibility. Its dark tint partially obscures the movement, creating depth. Baton indexes maintain a clear reading structure."}]}]},{"id":31,"__component":"content.media-fullscreen","disableParallax":true,"showWithoutMargin":false,"media":{"data":{"id":744,"attributes":{"name":"atelier 16-9_PIXEL.webp","alternativeText":null,"caption":null,"width":4598,"height":2587,"formats":{"thumbnail":{"name":"thumbnail_atelier 16-9_PIXEL.webp","hash":"thumbnail_atelier_16_9_PIXEL_f4b88022b3","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":576,"size":65.84,"sizeInBytes":65838,"url":"/uploads/thumbnail_atelier_16_9_PIXEL_f4b88022b3.webp"},"small":{"name":"small_atelier 16-9_PIXEL.webp","hash":"small_atelier_16_9_PIXEL_f4b88022b3","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":576,"size":65.84,"sizeInBytes":65838,"url":"/uploads/small_atelier_16_9_PIXEL_f4b88022b3.webp"},"xsmall":{"name":"xsmall_atelier 16-9_PIXEL.webp","hash":"xsmall_atelier_16_9_PIXEL_f4b88022b3","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":576,"size":65.84,"sizeInBytes":65838,"url":"/uploads/xsmall_atelier_16_9_PIXEL_f4b88022b3.webp"},"medium":{"name":"medium_atelier 16-9_PIXEL.webp","hash":"medium_atelier_16_9_PIXEL_f4b88022b3","ext":".webp","mime":"image/webp","path":null,"width":1440,"height":810,"size":138.23,"sizeInBytes":138228,"url":"/uploads/medium_atelier_16_9_PIXEL_f4b88022b3.webp"},"large":{"name":"large_atelier 16-9_PIXEL.webp","hash":"large_atelier_16_9_PIXEL_f4b88022b3","ext":".webp","mime":"image/webp","path":null,"width":1920,"height":1080,"size":271.57,"sizeInBytes":271569,"url":"/uploads/large_atelier_16_9_PIXEL_f4b88022b3.webp"},"xlarge":{"name":"xlarge_atelier 16-9_PIXEL.webp","hash":"xlarge_atelier_16_9_PIXEL_f4b88022b3","ext":".webp","mime":"image/webp","path":null,"width":2440,"height":1373,"size":490.06,"sizeInBytes":490056,"url":"/uploads/xlarge_atelier_16_9_PIXE