{"data":[{"id":33,"attributes":{"title":"NO.182","subtitle":" ","createdAt":"2026-02-27T11:17:40.862Z","updatedAt":"2026-05-12T14:23:06.620Z","publishedAt":"2026-04-30T09:08:36.076Z","rank":-5,"slug":"NO.182","richIntroduction":[{"type":"paragraph","children":[{"type":"text","text":"This 40 mm chronograph in 18 ct rose gold was originally conceived as a performance tool. Alpinaire transforms it by introducing a skeletonized movement, shifting the focus to structure and material."}]}],"mainMedia":{"data":{"id":735,"attributes":{"name":"close up face 16-9 PIXEL.webp","alternativeText":null,"caption":null,"width":7132,"height":4012,"formats":{"thumbnail":{"name":"thumbnail_close up face 16-9 PIXEL.webp","hash":"thumbnail_close_up_face_16_9_PIXEL_6985028e0d","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":576,"size":69.11,"sizeInBytes":69110,"url":"/uploads/thumbnail_close_up_face_16_9_PIXEL_6985028e0d.webp"},"medium":{"name":"medium_close up face 16-9 PIXEL.webp","hash":"medium_close_up_face_16_9_PIXEL_6985028e0d","ext":".webp","mime":"image/webp","path":null,"width":1440,"height":810,"size":124.74,"sizeInBytes":124738,"url":"/uploads/medium_close_up_face_16_9_PIXEL_6985028e0d.webp"},"small":{"name":"small_close up face 16-9 PIXEL.webp","hash":"small_close_up_face_16_9_PIXEL_6985028e0d","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":576,"size":69.11,"sizeInBytes":69110,"url":"/uploads/small_close_up_face_16_9_PIXEL_6985028e0d.webp"},"large":{"name":"large_close up face 16-9 PIXEL.webp","hash":"large_close_up_face_16_9_PIXEL_6985028e0d","ext":".webp","mime":"image/webp","path":null,"width":1920,"height":1080,"size":202.87,"sizeInBytes":202869,"url":"/uploads/large_close_up_face_16_9_PIXEL_6985028e0d.webp"},"xlarge":{"name":"xlarge_close up face 16-9 PIXEL.webp","hash":"xlarge_close_up_face_16_9_PIXEL_6985028e0d","ext":".webp","mime":"image/webp","path":null,"width":2440,"height":1373,"size":311.02,"sizeInBytes":311016,"url":"/uploads/xlarge_close_up_face_16_9_PIXEL_6985028e0d.webp"},"xsmall":{"name":"xsmall_close up face 16-9 PIXEL.webp","hash":"xsmall_close_up_face_16_9_PIXEL_6985028e0d","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":576,"size":69.11,"sizeInBytes":69110,"url":"/uploads/xsmall_close_up_face_16_9_PIXEL_6985028e0d.webp"}},"hash":"close_up_face_16_9_PIXEL_6985028e0d","ext":".webp","mime":"image/webp","size":6760.1,"url":"/uploads/close_up_face_16_9_PIXEL_6985028e0d.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-04-15T15:19:56.614Z","updatedAt":"2026-04-15T15:19:56.614Z"}}},"content":[{"id":92,"__component":"content.text-media","title":"The Owner’s Vision","richText":[{"type":"paragraph","children":[{"type":"text","text":"The project began with a worn movement that required extensive repairs. Rather than restoring it to its original state, the owner chose to rethink the watch entirely. He had long been drawn to skeletonized movements and saw this as the right opportunity to develop a custom project around that approach."}]}],"disableParallax":true,"media":{"data":{"id":745,"attributes":{"name":"Rolex skelet or rose_planche.webp","alternativeText":null,"caption":null,"width":4096,"height":4096,"formats":{"thumbnail":{"name":"thumbnail_Rolex skelet or rose_planche.webp","hash":"thumbnail_Rolex_skelet_or_rose_planche_a38e6ac9c2","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":218.98,"sizeInBytes":218977,"url":"/uploads/thumbnail_Rolex_skelet_or_rose_planche_a38e6ac9c2.webp"},"small":{"name":"small_Rolex skelet or rose_planche.webp","hash":"small_Rolex_skelet_or_rose_planche_a38e6ac9c2","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":218.98,"sizeInBytes":218977,"url":"/uploads/small_Rolex_skelet_or_rose_planche_a38e6ac9c2.webp"},"xsmall":{"name":"xsmall_Rolex skelet or rose_planche.webp","hash":"xsmall_Rolex_skelet_or_rose_planche_a38e6ac9c2","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":218.98,"sizeInBytes":218977,"url":"/uploads/xsmall_Rolex_skelet_or_rose_planche_a38e6ac9c2.webp"},"medium":{"name":"medium_Rolex skelet or rose_planche.webp","hash":"medium_Rolex_skelet_or_rose_planche_a38e6ac9c2","ext":".webp","mime":"image/webp","path":null,"width":1440,"height":1440,"size":403.81,"sizeInBytes":403810,"url":"/uploads/medium_Rolex_skelet_or_rose_planche_a38e6ac9c2.webp"},"large":{"name":"large_Rolex skelet or rose_planche.webp","hash":"large_Rolex_skelet_or_rose_planche_a38e6ac9c2","ext":".webp","mime":"image/webp","path":null,"width":1920,"height":1920,"size":661.25,"sizeInBytes":661250,"url":"/uploads/large_Rolex_skelet_or_rose_planche_a38e6ac9c2.webp"},"xlarge":{"name":"xlarge_Rolex skelet or rose_planche.webp","hash":"xlarge_Rolex_skelet_or_rose_planche_a38e6ac9c2","ext":".webp","mime":"image/webp","path":null,"width":2440,"height":2440,"size":986.08,"sizeInBytes":986075,"url":"/uploads/xlarge_Rolex_skelet_or_rose_planche_a38e6ac9c2.webp"}},"hash":"Rolex_skelet_or_rose_planche_a38e6ac9c2","ext":".webp","mime":"image/webp","size":7921.43,"url":"/uploads/Rolex_skelet_or_rose_planche_a38e6ac9c2.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-04-15T15:23:58.046Z","updatedAt":"2026-04-15T15:23:58.046Z"}}}},{"id":93,"__component":"content.text-media","title":"Restoration and Preparation","richText":[{"type":"paragraph","children":[{"type":"text","text":"The transformation begins with a complete disassembly in our Swiss workshops. Watchmakers and jewelers inspect, clean and service each component. The movement is restored to full function before any modification. Original finishes are preserved to provide a stable base for the next stages."}]}],"disableParallax":true,"media":{"data":{"id":741,"attributes":{"name":"Rolex skelet or rose_polissage.aep.webm","alternativeText":null,"caption":null,"width":null,"height":null,"formats":null,"hash":"Rolex_skelet_or_rose_polissage_aep_cf54c1edb3","ext":".webm","mime":"video/webm","size":6464.72,"url":"/uploads/Rolex_skelet_or_rose_polissage_aep_cf54c1edb3.webm","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-04-15T15:23:52.505Z","updatedAt":"2026-04-15T15:26:12.885Z"}}}},{"id":94,"__component":"content.text-media","title":"Design Research","richText":[{"type":"paragraph","children":[{"type":"text","text":"The project was developed through close collaboration between the client and our team. After exploring several directions, we focused on three key interventions: a skeletonized movement, a forged carbon bezel with luminescent material integrated in the mass, and a smoked sapphire dial. Each element was developed to form a coherent technical composition."}]}],"disableParallax":true,"media":{"data":{"id":761,"attributes":{"name":"Rolex skelet or rose_planche dessin 1-11 gris.webp","alternativeText":null,"caption":null,"width":4000,"height":4000,"formats":{"thumbnail":{"name":"thumbnail_Rolex skelet or rose_planche dessin 1-11 gris.webp","hash":"thumbnail_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":147.15,"sizeInBytes":147146,"url":"/uploads/thumbnail_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9.webp"},"small":{"name":"small_Rolex skelet or rose_planche dessin 1-11 gris.webp","hash":"small_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":147.15,"sizeInBytes":147146,"url":"/uploads/small_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9.webp"},"xsmall":{"name":"xsmall_Rolex skelet or rose_planche dessin 1-11 gris.webp","hash":"xsmall_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":147.15,"sizeInBytes":147146,"url":"/uploads/xsmall_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9.webp"},"medium":{"name":"medium_Rolex skelet or rose_planche dessin 1-11 gris.webp","hash":"medium_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9","ext":".webp","mime":"image/webp","path":null,"width":1440,"height":1440,"size":267.84,"sizeInBytes":267840,"url":"/uploads/medium_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9.webp"},"large":{"name":"large_Rolex skelet or rose_planche dessin 1-11 gris.webp","hash":"large_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9","ext":".webp","mime":"image/webp","path":null,"width":1920,"height":1920,"size":439.77,"sizeInBytes":439766,"url":"/uploads/large_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9.webp"},"xlarge":{"name":"xlarge_Rolex skelet or rose_planche dessin 1-11 gris.webp","hash":"xlarge_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9","ext":".webp","mime":"image/webp","path":null,"width":2440,"height":2440,"size":649.7,"sizeInBytes":649703,"url":"/uploads/xlarge_Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9.webp"}},"hash":"Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9","ext":".webp","mime":"image/webp","size":4477.97,"url":"/uploads/Rolex_skelet_or_rose_planche_dessin_1_11_gris_68dd9e2fa9.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-04-30T11:08:44.412Z","updatedAt":"2026-04-30T11:08:44.412Z"}}}},{"id":95,"__component":"content.text-media","title":"Skeleton Movement","richText":[{"type":"paragraph","children":[{"type":"text","text":"The calibre 4130 was fully skeletonized to expose its architecture. The bridges were reworked and reduced to open the view onto the gear train while maintaining structural integrity. The surfaces were given a cream finish, and the bevels were hand polished to define each edge. A black DLC treatment was then applied to unify the movement and enhance contrast."}]}],"disableParallax":true,"media":{"data":{"id":739,"attributes":{"name":"mouvement_retouché.webp","alternativeText":null,"caption":null,"width":3903,"height":3902,"formats":{"xsmall":{"name":"xsmall_mouvement_retouché.webp","hash":"xsmall_mouvement_retouche_7851d30593","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":82.12,"sizeInBytes":82124,"url":"/uploads/xsmall_mouvement_retouche_7851d30593.webp"},"thumbnail":{"name":"thumbnail_mouvement_retouché.webp","hash":"thumbnail_mouvement_retouche_7851d30593","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":82.12,"sizeInBytes":82124,"url":"/uploads/thumbnail_mouvement_retouche_7851d30593.webp"},"small":{"name":"small_mouvement_retouché.webp","hash":"small_mouvement_retouche_7851d30593","ext":".webp","mime":"image/webp","path":null,"width":1024,"height":1024,"size":82.12,"sizeInBytes":82124,"url":"/uploads/small_mouvement_retouche_7851d30593.webp"},"medium":{"name":"medium_mouvement_retouché.webp","hash":"medium_mouvement_retouche_7851d30593","ext":".webp","mime":"image/webp","path":null,"width":1440,"height":1440,"size":147.26,"sizeInBytes":147263,"url":"/uploads/medium_mouvement_retouche_7851d30593.webp"},"large":{"name":"large_mouvement_retouché.webp","hash":"large_mouvement_retouche_7851d30593","ext":".webp","mime":"image/webp","path":null,"width":1920,"height":1920,"size":244.39,"sizeInBytes":244386,"url":"/uploads/large_mouvement_retouche_7851d30593.webp"},"xlarge":{"name":"xlarge_mouvement_retouché.webp","hash":"xlarge_mouvement_retouche_7851d30593","ext":".webp","mime":"image/webp","path":null,"width":2440,"height":2439,"size":376.69,"sizeInBytes":376685,"url":"/uploads/xlarge_mouvement_retouche_7851d30593.webp"}},"hash":"mouvement_retouche_7851d30593","ext":".webp","mime":"image/webp","size":2653.86,"url":"/uploads/mouvement_retouche_7851d30593.webp","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-04-15T15:23:52.503Z","updatedAt":"2026-04-15T15:28:54.147Z"}}}},{"id":65,"__component":"content.media-duo","format